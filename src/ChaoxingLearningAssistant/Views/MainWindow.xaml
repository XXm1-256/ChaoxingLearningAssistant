<Window x:Class="ChaoxingLearningAssistant.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="学习通课程播放辅助 v1.32"
        Width="1540" Height="940"
        MinWidth="1220" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <!-- Very subtle ambient light. It adds depth without turning the app into a neon-game UI. -->
        <Canvas IsHitTestVisible="False" Opacity="0.52">
            <Ellipse Width="560" Height="560" Canvas.Left="-250" Canvas.Top="-310">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3A75C995" Offset="0"/>
                        <GradientStop Color="#00EEF6F0" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="640" Height="640" Canvas.Right="-300" Canvas.Top="-360">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3473C998" Offset="0"/>
                        <GradientStop Color="#00EEF6F0" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="78"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="38"/>
            </Grid.RowDefinitions>

            <!-- Top command deck -->
            <Border x:Name="TopCommandDeck" Grid.Row="0"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="46" Height="46" CornerRadius="13"
                                Background="{StaticResource AccentGradientBrush}"
                                Effect="{StaticResource GlowShadow}">
                            <TextBlock Text="CX" Foreground="White" FontWeight="Bold" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="学习通课程播放辅助" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="课程播放与章节辅助 · 数据仅保存在本机"
                                       FontSize="10.5" Margin="0,3,0,0"
                                       Foreground="{DynamicResource TertiaryTextBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="StartButton" Style="{StaticResource PrimaryButtonStyle}" Content="▶  开始" Click="Start_Click"/>
                        <Button x:Name="PauseVideoButton" Content="Ⅱ  暂停视频" Click="PauseVideo_Click"/>
                        <Button x:Name="PauseAutomationButton" Content="◇  暂停辅助" Click="PauseAutomation_Click"/>
                        <Button Content="■  停止" Click="Stop_Click"/>
                        <Border Width="1" Height="28" Background="{DynamicResource BorderBrush}" Margin="10,0"/>
                        <Button Style="{StaticResource GhostButtonStyle}" Content="刷新课程" Click="RefreshCourses_Click"/>
                        <Button Style="{StaticResource GhostButtonStyle}" Content="课程首页" Click="ReturnCourses_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource SurfaceMutedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="20" Padding="11,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0"/>
                                <TextBlock x:Name="TopStatusText"
                                           VerticalAlignment="Center"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="准备中"/>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource IconButtonStyle}" Content="▤" ToolTip="学习统计" Click="Stats_Click"/>
                        <Button Style="{StaticResource IconButtonStyle}" Content="≡" ToolTip="日志" Click="Logs_Click"/>
                        <Button Style="{StaticResource IconButtonStyle}" Content="?" ToolTip="使用教学" Click="Tutorial_Click"/>
                        <Button Style="{StaticResource IconButtonStyle}" Content="⚙" ToolTip="设置" Click="Settings_Click"/>
                        <Button Style="{StaticResource IconButtonStyle}" Content="⌁" ToolTip="导出诊断包" Click="ExportDiagnostics_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main three-column workspace -->
            <Grid x:Name="MainWorkspace" Grid.Row="1" Margin="18,18,18,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftNavigationColumn" Width="318"/>
                    <ColumnDefinition x:Name="LeftSplitterColumn" Width="14"/>
                    <ColumnDefinition x:Name="BrowserColumn" Width="*"/>
                    <ColumnDefinition x:Name="RightSplitterColumn" Width="14"/>
                    <ColumnDefinition x:Name="TelemetryColumn" Width="338"/>
                </Grid.ColumnDefinitions>

                <!-- Left navigation card -->
                <Border x:Name="LeftNavigationCard" Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="14"
                        Effect="{StaticResource PanelShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="4,2,4,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="课程目录" Style="{StaticResource EyebrowTextStyle}"/>
                                <TextBlock Text="课程与章节" Style="{StaticResource SectionTitleStyle}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}"
                                    Content="打开未完成章节" ToolTip="只打开平台明确标记为未完成的章节"
                                    Click="JumpToUnfinished_Click" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,8"/>

                        <TabControl x:Name="LibraryTabs" Grid.Row="2" Margin="0">
                            <TabItem Header="课程">
                                <ListBox x:Name="CourseList"
                                         ItemsSource="{Binding Courses}"
                                         SelectedItem="{Binding SelectedCourse}"
                                         SelectionChanged="CourseList_SelectionChanged"
                                         MouseDoubleClick="CourseList_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="34" Height="34" CornerRadius="9"
                                                            Background="{DynamicResource AccentSoftBrush}"
                                                            BorderBrush="{DynamicResource BorderStrongBrush}"
                                                            BorderThickness="1" Margin="0,0,10,0">
                                                        <TextBlock Text="▰" Foreground="{DynamicResource AccentBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" ToolTip="{Binding Title}" TextWrapping="Wrap"
                                                               FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock Grid.Row="1" Margin="44,7,0,6" FontSize="11.5"
                                                           Text="{Binding ProgressSummary, Mode=OneWay}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                <ProgressBar Grid.Row="2" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Margin="44,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </TabItem>
                            <TabItem Header="章节">
                                <ListBox x:Name="ChapterList"
                                         ItemsSource="{Binding Chapters}"
                                         SelectedItem="{Binding SelectedChapter, Mode=OneWay}"
                                         PreviewMouseLeftButtonDown="ChapterList_PreviewMouseLeftButtonDown">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="›" FontSize="16" Margin="0,0,9,0"
                                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" ToolTip="{Binding DisplayTitle}"
                                                           TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>

                <GridSplitter x:Name="LeftWorkspaceSplitter" Grid.Column="1" Width="14" HorizontalAlignment="Stretch" Background="Transparent"/>

                <!-- Center browser workspace -->
                <Border x:Name="BrowserWorkspaceCard" Grid.Column="2" Style="{StaticResource CardBorderStyle}" Effect="{StaticResource PanelShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="64"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="BrowserToolbar" Margin="14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}" Content="←" ToolTip="后退" Click="Back_Click"/>
                            <Border Grid.Column="1" Margin="7,0,7,0" CornerRadius="11"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⌁" Foreground="{DynamicResource AccentBrush}" FontSize="15"
                                               VerticalAlignment="Center" Margin="12,0,3,0"/>
                                    <TextBox x:Name="AddressBox" Grid.Column="1" VerticalContentAlignment="Center"
                                             BorderThickness="0" Background="Transparent" Margin="0"
                                             ToolTip="可手动粘贴学习通课程或章节地址"/>
                                </Grid>
                            </Border>
                            <Button Grid.Column="2" Content="打开" Click="OpenAddress_Click"/>
                            <Button Grid.Column="3" Style="{StaticResource GhostButtonStyle}" Content="刷新" Click="Reload_Click"/>
                            <Button Grid.Column="4" Style="{StaticResource IconButtonStyle}" Content="↤"
                                    ToolTip="向左横移网页；也可按住 Shift 滚动鼠标滚轮"
                                    Click="ScrollLeft_Click"/>
                            <Button Grid.Column="5" Style="{StaticResource IconButtonStyle}" Content="↦"
                                    ToolTip="向右横移网页；也可按住 Shift 滚动鼠标滚轮"
                                    Click="ScrollRight_Click"/>
                            <Button x:Name="ViewingModeButton" Grid.Column="6"
                                    Style="{StaticResource IconButtonStyle}" Content="▣"
                                    ToolTip="宽屏观看（非全屏，F11）"
                                    Click="ToggleViewingMode_Click"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="12,0,12,12">
                            <Border CornerRadius="13" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Background="{DynamicResource InputBackgroundBrush}" ClipToBounds="True">
                                <wv2:WebView2 x:Name="Browser"/>
                            </Border>

                            <!-- Welcome hero -->
                            <Border x:Name="WelcomePanel"
                                    Panel.ZIndex="4"
                                    Width="660" MaxWidth="760"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource HeroGradientBrush}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="22"
                                    Padding="34"
                                    Effect="{StaticResource PanelShadow}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel>
                                        <Border HorizontalAlignment="Left" Background="#241DA9FF"
                                                BorderBrush="#566FBFFF" BorderThickness="1" CornerRadius="13" Padding="9,4">
                                            <TextBlock Text="准备就绪" FontSize="10" FontWeight="Bold" Foreground="#9BD2FF"/>
                                        </Border>
                                        <TextBlock Text="专注课程，&#x0a;减少重复操作。"
                                                   FontSize="30" FontWeight="SemiBold" LineHeight="41"
                                                   Margin="0,16,0,0" Foreground="White"/>
                                        <TextBlock Text="课程定位、播放状态、倍速继承、下一视频切换和本地诊断，都集中在这个界面。"
                                                   TextWrapping="Wrap" FontSize="13.5" LineHeight="23"
                                                   Foreground="#B9C9DD" Margin="0,12,0,0"/>
                                    </StackPanel>

                                    <Grid Grid.Row="1" Margin="0,26,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource SubtleCardBorderStyle}" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="本地保存" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                                <TextBlock Text="账号与统计保存在本机" FontSize="10.5" Foreground="#9FB1C7" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource SubtleCardBorderStyle}" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="实时状态" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                                <TextBlock Text="显示当前播放器状态" FontSize="10.5" Foreground="#9FB1C7" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="4" Style="{StaticResource SubtleCardBorderStyle}" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="安全保护" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                                <TextBlock Text="验证页面立即暂停辅助" FontSize="10.5" Foreground="#9FB1C7" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="2" Margin="0,26,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="ContinueLastButton" Grid.Column="0"
                                                Style="{StaticResource GradientButtonStyle}"
                                                Height="52" FontSize="14.5"
                                                Content="▶  继续上次学习"
                                                Click="ContinueLast_Click"/>
                                        <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}"
                                                Height="52" MinWidth="132" Content="选择课程"
                                                Click="ChooseCourse_Click"/>
                                    </Grid>

                                    <Button Grid.Row="3" Style="{StaticResource GhostButtonStyle}"
                                            HorizontalAlignment="Left" Margin="-4,12,0,0"
                                            Content="查看今日学习统计  →" Click="WelcomeStats_Click"/>

                                    <Border Grid.Row="4" Margin="0,23,0,0" Height="1" Background="#305879A0"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <GridSplitter x:Name="RightWorkspaceSplitter" Grid.Column="3" Width="14" HorizontalAlignment="Stretch" Background="Transparent"/>

                <!-- Right telemetry panel -->
                <Border x:Name="RightTelemetryCard" Grid.Column="4" Style="{StaticResource CardBorderStyle}" Padding="15"
                        Effect="{StaticResource PanelShadow}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="3,1,3,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="播放信息" Style="{StaticResource EyebrowTextStyle}"/>
                                    <TextBlock Text="运行状态" Style="{StaticResource SectionTitleStyle}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="13" Padding="9,4" VerticalAlignment="Center">
                                    <TextBlock Text="实时状态" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </Grid>

                            <!-- Status hero -->
                            <Border Background="{StaticResource HeroGradientBrush}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                    CornerRadius="14" Padding="15" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="视频状态" FontSize="10.5" FontWeight="SemiBold" Foreground="#86BFFF"/>
                                    <TextBlock Text="{Binding PlaybackStatusText}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" Foreground="White"/>
                                    <StackPanel Margin="0,9,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0"/>
                                            <TextBlock Text="{Binding AutomationStatusText}" FontSize="10.5" Foreground="#D5E2F2"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="14,4,0,0">
                                            <TextBlock Text="辅助状态：" FontSize="10" Foreground="#AFC1D7"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="#AFC1D7"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SubtleCardBorderStyle}" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="当前课程" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock x:Name="CurrentCourseText" Text="-" TextWrapping="Wrap"
                                               FontSize="14" FontWeight="SemiBold" Margin="0,5,0,12"/>
                                    <TextBlock Text="当前章节" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock Text="{Binding CurrentChapterText}" TextWrapping="Wrap"
                                               FontSize="13" Margin="0,5,0,12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="当前视频" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock Text="{Binding CurrentVideoText}" TextWrapping="Wrap"
                                               FontSize="13" Margin="0,5,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SubtleCardBorderStyle}" Padding="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="播放时间" Style="{StaticResource MetricLabelStyle}"/>

                                    <Border Grid.Column="1"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            BorderBrush="{DynamicResource BorderStrongBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="9,4"
                                            Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="倍速  " FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding PlaybackRateText}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <Viewbox Grid.Row="1" Grid.ColumnSpan="2"
                                             Stretch="Uniform"
                                             StretchDirection="DownOnly"
                                             HorizontalAlignment="Left"
                                             MaxHeight="34"
                                             Margin="0,7,0,0">
                                        <TextBlock Text="{Binding PlayerTimeText}"
                                                   ToolTip="{Binding PlayerTimeText}"
                                                   FontFamily="Consolas"
                                                   FontSize="23"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </Viewbox>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SubtleCardBorderStyle}" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="播放进度" Style="{StaticResource MetricLabelStyle}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat={}{0:F0}%}"
                                                   FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="8" Margin="0,9,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SubtleCardBorderStyle}" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="下一视频" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{Binding NextVideoText}" TextWrapping="Wrap" FontSize="13.5" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="网络状态" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="#1D1C543D" BorderBrush="#553DDC97" BorderThickness="1" CornerRadius="10" Padding="8,3">
                                            <TextBlock Text="{Binding NetworkText}" FontSize="10" Foreground="{DynamicResource SuccessBrush}"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Button x:Name="ContinueNextButton"
                                    Style="{StaticResource GradientButtonStyle}"
                                    Content="▶  继续下一节"
                                    FontSize="15"
                                    MinHeight="50"
                                    Margin="0,2,0,10"
                                    Visibility="Collapsed"
                                    Click="ContinueNext_Click"/>

                            <Border Padding="13" Background="#161A2A3D"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,10,0">
                                        <TextBlock Text="✓" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="安全保护已开启" FontWeight="SemiBold" FontSize="12.5"/>
                                        <TextBlock Text="默认在视频自然结束后切换下一章节并延续播放/倍速；验证码、人脸、风控或学校认证页面仍会暂停辅助流程。"
                                                   TextWrapping="Wrap" LineHeight="18" FontSize="10.5" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel x:Name="DeveloperPanel" Visibility="Collapsed" Margin="0,4,0,0">
                                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,12"/>
                                <TextBlock Text="开发者诊断" Style="{StaticResource EyebrowTextStyle}"/>
                                <Border Style="{StaticResource SubtleCardBorderStyle}" Padding="12" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="DevUrlText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock x:Name="DevTaskText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="10.5" Margin="0,5,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock x:Name="DevSelectorText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="10.5" Margin="0,5,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock x:Name="DevErrorText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="10.5" Margin="0,5,0,0" Foreground="{DynamicResource DangerBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Footer -->
            <Border x:Name="FooterBar" Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource PanelBackgroundBrush}" Padding="20,0">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="BottomHintText"
                                   Text="章节只有在播放器真实切换后才会高亮；F11 为非全屏宽屏观看。"
                                   FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                               Text="数据仅保存在本机"
                               FontSize="10" Foreground="{DynamicResource TertiaryTextBrush}"/>
                </DockPanel>
            </Border>
        </Grid>

        <Border x:Name="InAppNotice"
                Width="390" MinHeight="82"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,92,28,0" Padding="0"
                Visibility="Collapsed" Panel.ZIndex="20"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                CornerRadius="18" Effect="{StaticResource PanelShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="NoticeAccentBar" Background="{DynamicResource AccentBrush}" CornerRadius="18,0,0,18"/>
                <StackPanel Grid.Column="1" Margin="16,13,18,13">
                    <TextBlock x:Name="NoticeTitleText" FontSize="13.5" FontWeight="SemiBold"/>
                    <TextBlock x:Name="NoticeMessageText" Margin="0,4,0,0" TextWrapping="Wrap"
                               FontSize="11.5" LineHeight="18" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
