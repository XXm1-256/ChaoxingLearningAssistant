<Window x:Class="ChaoxingLearningAssistant.Views.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="今日学习统计 · 学习通课程播放辅助" Width="1100" Height="680"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="2,0,2,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="今日" Style="{StaticResource EyebrowTextStyle}"/>
                <TextBlock Text="今日学习统计" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                <TextBlock x:Name="SummaryText" FontSize="12" Margin="0,5,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="刷新数据" Click="Refresh_Click"/>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="8" Effect="{StaticResource PanelShadow}">
            <DataGrid x:Name="StatsGrid" Margin="0"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      AlternationCount="2" RowHeight="38" ColumnHeaderHeight="38">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="课程" Binding="{Binding CourseTitle}" Width="180"/>
                    <DataGridTextColumn Header="章节" Binding="{Binding ChapterTitle}" Width="180"/>
                    <DataGridTextColumn Header="视频" Binding="{Binding VideoTitle}" Width="230"/>
                    <DataGridTextColumn Header="开始" Binding="{Binding StartedAt, StringFormat=HH:mm:ss}" Width="90"/>
                    <DataGridTextColumn Header="结束" Binding="{Binding EndedAt, StringFormat=HH:mm:ss}" Width="90"/>
                    <DataGridTextColumn Header="实际播放秒数" Binding="{Binding WatchedSeconds, StringFormat=F0}" Width="105"/>
                    <DataGridTextColumn Header="倍速" Binding="{Binding PlaybackRate, StringFormat=F2}" Width="70"/>
                    <DataGridTextColumn Header="结果" Binding="{Binding FinalStatus}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
