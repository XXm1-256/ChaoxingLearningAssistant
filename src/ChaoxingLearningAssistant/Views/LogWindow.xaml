<Window x:Class="ChaoxingLearningAssistant.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="运行日志 · 学习通课程播放辅助" Width="980" Height="700"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="2,0,2,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="诊断信息" Style="{StaticResource EyebrowTextStyle}"/>
                <TextBlock Text="运行日志" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                <TextBlock x:Name="PathText" Margin="0,5,0,0" FontSize="10.5" Foreground="{DynamicResource TertiaryTextBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="刷新" Click="Refresh_Click"/>
                <Button Style="{StaticResource GhostButtonStyle}" Content="打开日志目录" Click="OpenFolder_Click"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="8" Effect="{StaticResource PanelShadow}">
            <TextBox x:Name="LogText" Margin="0"
                     FontFamily="Consolas" FontSize="12.5"
                     IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                     BorderThickness="0" Background="{DynamicResource InputBackgroundBrush}"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"/>
        </Border>
    </Grid>
</Window>
